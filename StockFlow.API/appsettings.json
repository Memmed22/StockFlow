{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Telegram": {
    "BotToken": "YOUR_BOT_TOKEN",
    "ChatId": "YOUR_CHAT_ID"
  },
  "Update": {
    "GithubOwner": "Memmed22",
    "GithubRepo": "StockFlow"
  },
  "Sync": {
    "IntervalHours": 4,
    "FailureThreshold": 3,
    "StaleAfterHours": 12,
    "RetainedSnapshots": 30
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=stockflow.db"
  },
  "Urls": "http://localhost:5000"
}
